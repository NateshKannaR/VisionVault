{
  "manifest_version": 3,
  "name": "VisionVault",
  "version": "2.0.0",
  "description": "A private browser agent: reads the screen on your device, masks anything personal before a planner sees it, and carries out multi-step tasks on any website.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "sidePanel", "offscreen"],
  "host_permissions": ["<all_urls>", "file://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VisionVault",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["action-executor.js", "page-reader.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "models/*",
        "models/tessdata/*",
        "vision/*",
        "offscreen.html",
        "offscreen.js"
      ],
      "matches": ["<all_urls>", "file://*/*"]
    }
  ]
}
