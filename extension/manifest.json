{
  "manifest_version": 3,
  "name": "Privacy Vision Agent",
  "version": "1.0.0",
  "description": "Local PII redaction + vault + cloud VLM automation on sanitized screens.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>", "file://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Privacy Vision Agent"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
