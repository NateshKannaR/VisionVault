# Choose optional providers. An empty OLLAMA_HOST skips discovery.
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=20

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# At least 32 characters. Required when connecting from outside the host loopback interface.
VISIONVAULT_API_TOKEN=
# Optional comma-separated list of exact web origins that need CORS.
VISIONVAULT_ALLOWED_ORIGINS=
