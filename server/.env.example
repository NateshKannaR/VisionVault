# Copy this file to .env and fill in a key for the tier you want to use.
#
# Planning chain (server/main.py): Gemini -> Groq -> deterministic rule-based planner.
# With no key set, the server runs entirely on the rule-based planner and needs no network.

# Tier 1 — Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tier 2 — Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Server port (default 8000)
PORT=8000

# Local model used by the Ollama tier. Left unset, the server picks the best it finds,
# excluding coder and embedding models (wrong tool, and usually the largest on the machine).
# qwen2.5:3b-instruct is the sweet spot measured here: ~1-2s per step, where 14B took 28-55s
# and 1.5B was too weak to hold a multi-step task.
OLLAMA_MODEL=qwen2.5:3b-instruct
