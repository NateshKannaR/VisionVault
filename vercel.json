{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/visionvault-extension.zip",
      "destination": "/downloads/visionvault-chromium.zip",
      "permanent": false
    },
    {
      "source": "/employee-portal",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/employee-portal.html",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/hr-portal",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/hr-portal.html",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/isro-intranet-demo",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/isro-intranet-demo.html",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/employee-portal/index.html",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/hr-portal/index.html",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/login/index.html",
      "destination": "/#inspector",
      "permanent": false
    },
    {
      "source": "/isro-intranet-demo/index.html",
      "destination": "/#inspector",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; font-src 'self' https: data:; media-src 'self' https: data: blob:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
