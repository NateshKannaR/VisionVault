{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/visionvault-extension.zip",
      "destination": "/downloads/visionvault-chromium.zip",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/employee-portal", "destination": "/employee-portal.html" },
    { "source": "/employee-portal/", "destination": "/employee-portal.html" },
    { "source": "/employee-portal.html", "destination": "/employee-portal.html" },
    { "source": "/hr-portal", "destination": "/hr-portal.html" },
    { "source": "/hr-portal/", "destination": "/hr-portal.html" },
    { "source": "/hr-portal.html", "destination": "/hr-portal.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/", "destination": "/login.html" },
    { "source": "/login.html", "destination": "/login.html" },
    { "source": "/isro-intranet-demo", "destination": "/isro-intranet-demo.html" },
    { "source": "/isro-intranet-demo/", "destination": "/isro-intranet-demo.html" },
    { "source": "/isro-intranet-demo.html", "destination": "/isro-intranet-demo.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; font-src 'self' https: data:; media-src 'self' https: data: blob:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
